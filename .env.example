# FreeTimers environment template
#
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets.
# Keep secret-bearing values server-only and never expose them with NEXT_PUBLIC_.
#
# Public app metadata
APP_ENV=development
NEXT_PUBLIC_APP_NAME=FreeTimers
NEXT_PUBLIC_DEFAULT_LOCALE=es

# Map and geocoding (public-safe; browser-visible if configured)
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Routing (prefer self-hosted OSRM/GraphHopper for privacy; API key only if using a hosted provider)
ROUTING_PROVIDER=osm
ROUTING_BASE_URL=http://localhost:5000
ROUTING_API_KEY=replace_with_your_routing_api_key_if_needed
ROUTING_TIMEOUT_MS=10000

# Activities, places, and context (public-safe unless provider terms require attribution)
ACTIVITY_PROVIDER=overpass
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
WIKIMEDIA_BASE_URL=https://en.wikipedia.org/w/api.php

# Weather (public-safe)
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1

# Optional LLM explanations (server-only; no secret in browser bundle)
LLM_PROVIDER=none
OPENAI_API_KEY=replace_with_your_openai_api_key
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional public transport; enable only after a real GTFS/OTP connection is implemented
PUBLIC_TRANSPORT_PROVIDER=none
GTFS_BASE_URL=
OTP_BASE_URL=

# Optional personal configuration
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_RETURN_MARGIN_MINUTES=30
